{
  "name": "metflux",
  "version": "0.1.0",
  "private": true,
  "description": "Metflux — multi-tenant admin panel + portfolio (Hostinger Node.js + MySQL)",
  "workspaces": [
    "server",
    "client",
    "portfolio"
  ],
  "scripts": {
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "dev:portfolio": "npm --workspace portfolio run dev",
    "build:client": "npm --workspace client run build",
    "build:portfolio": "npm --workspace portfolio run build",
    "build:portfolio:if-needed": "node -e \"if(!require('fs').existsSync('portfolio/out')){process.exit(1)}\" || npm run build:portfolio",
    "build": "npm run build:client && npm run build:portfolio:if-needed && npm --workspace server run build:copy-client && npm --workspace server run build:copy-portfolio",
    "start": "npm --workspace server run start",
    "postinstall": "node node_modules/prisma/build/index.js generate --schema=server/prisma/schema.prisma",
    "prisma:generate": "npm --workspace server run prisma:generate",
    "prisma:migrate": "npm --workspace server run prisma:migrate",
    "prisma:studio": "npm --workspace server run prisma:studio"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
