# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- URLs ---
# Public-facing URL of the admin SPA (used in WhatsApp share links, emails, etc.)
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API in dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Hostinger MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="mysql://root:password@localhost:3306/metflux"

# --- Auth ---
# Generate strong values: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=15d

# Public signup is disabled by default — admins create users inside the panel.
ALLOW_PUBLIC_SIGNUP=false

# --- Web Push (VAPID) ---
# Generate: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@metfluxelectricals.com

# --- Bootstrap super-admin (used by seed script only) ---
SEED_SUPERADMIN_EMAIL=admin@metflux.com
SEED_SUPERADMIN_USERNAME=admin
SEED_SUPERADMIN_PASSWORD=ChangeMe!123
SEED_DEFAULT_COMPANY_NAME=Metflux Demo Co
