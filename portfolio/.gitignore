node_modules/
.next/
# Intermediate next-build dir — build-brand.mjs renames it to out-<brand>/.
out/
# NOTE: out-metflux/ and out-toroflux/ are intentionally NOT ignored — pre-built
# locally via `npm run build:portfolio` and committed so Hostinger doesn't have
# to run `next build` on every deploy. server/scripts/copy-portfolio.js ships
# them into server/public/portfolio-<brand>/ at deploy time; hostRouter.js
# picks the right brand per request hostname.
# .next/ stays ignored — it's only used during `next build` itself.
.env*
!.env.example
*.tsbuildinfo
.DS_Store
