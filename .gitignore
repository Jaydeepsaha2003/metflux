# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
server/public/admin/
server/public/portfolio/
client/dist/
portfolio/.next/
# NOTE: portfolio/out/ is intentionally NOT ignored — committed so Hostinger
# can skip `next build` (see portfolio/.gitignore for context).

# Env / secrets
.env
.env.local
.env.*.local
server/private/keys/

# Generated content (server-only)
server/private/invoices/*
!server/private/invoices/.gitkeep
server/public/uploads/*
!server/public/uploads/.gitkeep

# Prisma
server/prisma/migrations/dev.db*

# Logs
logs/
*.log
npm-debug.log*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

package-lock.json
**/package-lock.json
