# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
server/public/admin/
server/public/portfolio/
server/public/portfolio-metflux/
server/public/portfolio-toroflux/
client/dist/
portfolio/.next/
# Intermediate next-build output — build-brand.mjs renames out/ to out-<brand>/.
portfolio/out/
# NOTE: portfolio/out-metflux/ and portfolio/out-toroflux/ are intentionally
# NOT ignored — committed so Hostinger can skip `next build` for both brands.
# See portfolio/.gitignore for context.

# Env / secrets
.env
.env.local
.env.*.local
server/private/keys/

# Generated content (server-only)
server/private/invoices/*
!server/private/invoices/.gitkeep
server/public/uploads/*
!server/public/uploads/.gitkeep

# Prisma
server/prisma/migrations/dev.db*

# Logs
logs/
*.log
npm-debug.log*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

package-lock.json
**/package-lock.json
